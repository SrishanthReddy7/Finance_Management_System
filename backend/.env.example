NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# The company's own 15-character GSTIN. Optional: invoices work without it, but
# the CGST/SGST vs IGST split (FRS 14.3) is skipped until it is set, because the
# first two digits are the state code that decision depends on.
COMPANY_GSTIN=""

# Razorpay payment gateway (Payment Gateway Stage 4). Optional: leave blank
# until real credentials exist -- nothing else depends on these being set.
# The Razorpay client only fails when actually constructed/used, not at boot.
# RAZORPAY_MODE is "test" or "live"; anything else falls back to "test".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Payout Subsystem Step 2: symmetric key for encrypting EmployeePayoutAccount
# bank account numbers at rest (AES-256-GCM). NOT a RazorpayX credential --
# purely a local encryption key this application generates and owns. Optional
# at boot like the keys above; only payout-account creation/read actually
# needs it. Must be a 64-character hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_FIELD_ENCRYPTION_KEY=

# RazorpayX (Payout Subsystem Step 3B-1). Reuses RAZORPAY_KEY_ID/
# RAZORPAY_KEY_SECRET above -- RazorpayX and the Payment Gateway share the
# same account/key pair (Step 3A research), so no separate RAZORPAYX_KEY_*
# variables exist. Only the RazorpayX-specific operating current-account
# number needs its own variable, required later by the Payout API (NOT used
# by Contact/Fund Account provisioning, which is all this step implements).
RAZORPAYX_ACCOUNT_NUMBER=

# RazorpayX payout WEBHOOK secret (Payout Subsystem Step 3C). A SEPARATE
# secret from RAZORPAY_KEY_SECRET (API auth) and RAZORPAY_WEBHOOK_SECRET (the
# inbound Payment Gateway's own webhook, a different Razorpay product
# surface/URL) -- RazorpayX lets each webhook URL carry its own secret, and
# this payout webhook is registered at a different URL than the inbound one.
RAZORPAYX_WEBHOOK_SECRET=
