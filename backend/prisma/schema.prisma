}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  VERIFIED
  FAILED
  CANCELLED
}

// Payment Gateway Stage 9 (Stage 8 design, approved decision: REQUESTED ->
// PROCESSING -> PROCESSED, with REQUESTED -> CANCELLED and PROCESSING ->
// FAILED as the only other terminal paths -- no extra states added). PROCESSED
// and FAILED and CANCELLED are all terminal; a later stage's webhook handler
// must never let a late/out-of-order event overwrite a terminal status (same
// discipline as PaymentTransactionStatus's own terminal states today).
enum PaymentRefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
}

// Payout Subsystem Stage 1. What the payout is FOR -- deliberately just the
// three sources this task defines; add a value here (never a fourth nullable
// FK column) if a new payout source is ever needed.
enum PayoutPurpose {
  REIMBURSEMENT
  SALARY
  VENDOR_PAYMENT
}

// Payout Subsystem Stage 2 (audit decision): payout SUBMISSION now has its
// own maker-checker approval gate, layered ON TOP OF -- not a replacement
// for -- the source entity's own approval (a Reimbursement/Payslip/
// VendorBill is already APPROVED/FINALIZED before a Payout can exist at
// all). AWAITING_APPROVAL/APPROVED/REJECTED mirror this schema's other
// maker-checker flows (PayrollRun PROCESSED->FINALIZED via
// preparedById/finalizedById; VendorBill APPROVED via
// createdById/approvedById; PaymentRefund REQUESTED->PROCESSING via
// requestedById/an approving actor). The intended flow:
//
//   Finance Maker creates the payout        -> CREATED
//   submitted for checker review            -> AWAITING_APPROVAL
//   Finance Checker approves (!= maker)     -> APPROVED
//   Finance Checker rejects                 -> REJECTED
//   provider submission after APPROVED      -> QUEUED / PROCESSING
//   provider confirms funds moved           -> PROCESSED
//
// REJECTED and CANCELLED are deliberately NOT conflated: REJECTED is a
// checker's considered decision against a specific payout request
// (analogous to VendorBillStatus.REJECTED); CANCELLED is Finance
// withdrawing a payout before submission -- reachable only from CREATED or
// AWAITING_APPROVAL, never from APPROVED/QUEUED/PROCESSING onward
// (analogous to VendorBillStatus.CANCELLED, and enforced in the service
// layer's transition map the same way PayrollRun/VendorBill enforce theirs
// -- Prisma enums carry no transition graph of their own).
//
// No PENDING: nothing actionable happens between CREATED and
// AWAITING_APPROVAL that a separate state earns.
//
// PROCESSED, FAILED, REVERSED, CANCELLED, and REJECTED are all terminal --
// a webhook must never resurrect any of them (same discipline
// PaymentRefundStatus/PaymentTransactionStatus already document). An
// explicit, human-initiated retry out of FAILED is a deliberate, separate
// action from webhook processing (see the Payout model's own RETRY/
// IDEMPOTENCY POLICY comment).
enum PayoutStatus {
  CREATED
  AWAITING_APPROVAL
  APPROVED
  QUEUED
  PROCESSING
  PROCESSED
  REJECTED
  FAILED
  REVERSED
  CANCELLED
}

// Payout Subsystem Stage 1. Separate from PaymentGatewayProvider (money IN,
// RAZORPAY only) by deliberate choice -- money-in and money-out providers are
// different integrations and different risk surfaces, even though both may
// eventually be Razorpay-family products. MOCK is a first-class, permanent
// value (not a placeholder to delete later): the company has no RazorpayX
// account yet, so a MockPayoutProvider is expected to be the only
// implementation for a while, and the schema must not assume RazorpayX
// exists.
enum PayoutProvider {
  MOCK
  RAZORPAYX
}

// Payout Subsystem Stage 1.
enum PayoutAccountVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}
